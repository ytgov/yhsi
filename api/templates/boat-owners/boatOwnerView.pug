//- template.pug

style
  include ../styles.css
  | @page { margin: 24px; }

table.title-row
  tbody
    tr
      td
        div(style="margin-top: 15px") Yukon Heritage Information System
        .item-name #{ data.Name }
      td.brand-logo
        include ../yukon.svg

.section
  .section-title General information
  .subhead Alias
  each val in data.alias
    .subfield #{ val.Alias }
  else
    .subfield.empty None recorded
  .subhead Boats Owned
  each val in data.boats
    .subfield #{ val.Name }
  else
    .subfield.empty None recorded

.section
  .section-title History
  each val in data.histories
    .subfield
      | #{ val.HistoryText }
      br
      em Reference: #{ val.Reference }
  else
    .subfield.empty None recorded
