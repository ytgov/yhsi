//- template.pug

style
  include ../styles.css
  | @page { margin: 24px; }

table.title-row
  tbody
    tr
      td
        div(style="margin-top: 15px") Yukon Heritage Information System
        .item-name #{ data.Surname }, #{ data.GivenName }
      td.brand-logo
        include ../yukon.svg

.section
  .section-title Personal information
  table.divided-row
    tbody
      tr
        td
          .field
            span.label Surname
            span.value #{ data.Surname }
          .field
            span.label Given Name
            span.value #{ data.GivenName }
          .field
            span.label Notes
            span.value #{ data.Notes }
        td
          .field
            span.label Birth Year
            span.value #{ data.BirthYear }
          .field
            span.label Death Year
            span.value #{ data.DeathYear }

.section
  .section-title History
  each val in data.histories
    .subfield
      | #{ val.HistoryText }
      br
      em Reference: #{ val.Reference }
  else
    .subfield.empty None recorded
